# Frontend (Vite) — leave empty in dev so the Vite proxy forwards /api to the
# local RSVP server. In production set it to your deployed API origin, e.g.
# VITE_API_BASE_URL="https://rsvp.example.com"
VITE_API_BASE_URL=

# RSVP server (server/index.ts)
PORT=3001
# Comma-separated browser origins allowed to POST an RSVP (empty = allow all, dev only)
ALLOWED_ORIGINS=
# Set a secret to enable GET /api/rsvp (lists submissions)
ADMIN_TOKEN=
# Where the SQLite file lives (defaults to ./data/rsvps.db)
DATABASE_PATH=
